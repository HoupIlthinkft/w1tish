{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "frontend",
  "version": "0.1.0",
  "identifier": "net.w1tish.chat",
  "build": {
    "frontendDist": "../../static",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run vite dev",
    "beforeBuildCommand": "npm run vite build"
  },
  "app": {
    "windows": [
      {
        "title": "w1tish",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
